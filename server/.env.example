# Runtime environment: development | test | production
NODE_ENV=development

# Network binding (0.0.0.0 accepts connections across all interfaces; PORT is Express)
HOST=0.0.0.0
PORT=3000

# Reverse proxy trust (set true behind Nginx, Cloudflare, or cloud load balancers)
TRUST_PROXY=false

# Security & HTTP limits
BODY_LIMIT=10kb
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string (matches docker-compose.yml local defaults)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql://cadence:cadence_dev_pass@localhost:5432/cadence_dev

# Observability & lifecycle
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000 